// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  TALENT
  EMPLOYER
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum JobReportReason {
  SCAM
  MISLEADING
  ALREADY_FILLED
  DISCRIMINATORY
  DUPLICATE
  OTHER
}

enum JobReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum AlertFrequency {
  IMMEDIATE
  DAILY
  WEEKLY
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  CLOSED
  REJECTED
}

enum PlanType {
  STANDARD
  FEATURED
  HANDS_ON
}

enum TalentVisibility {
  PUBLIC
  VERIFIED_EMPLOYERS
}

// ─── User (Auth base) ─────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String?
  name                 String?
  image                String?
  role                 UserRole  @default(TALENT)
  // Settings > Account: decorative in the reference design, but these are
  // real, persisted per-user display preferences (not enforced anywhere yet
  // — no i18n/locale switching or currency-formatting logic reads them).
  phone                String?
  language             String    @default("English")
  region               String    @default("Vietnam")
  currencyDisplay      String    @default("USD ($)")
  // Settings > Danger zone "Pause my account": reversible, unlike delete.
  // Deliberately does NOT block sign-in (AuthService.validateCredentials) —
  // the reference design's "reactivate anytime" copy requires being able to
  // log back in to flip it off. Not enforced anywhere else yet (e.g. a
  // paused talent's public profile is still reachable by direct link) —
  // narrower than the reference design's "hidden from search" copy implies.
  isPaused             Boolean   @default(false)
  pausedAt             DateTime?
  // Settings > Security "Two-factor authentication". twoFactorSecret is the
  // base32 TOTP secret (set on /auth/2fa/setup, before twoFactorEnabled
  // flips true on /auth/2fa/verify) — stored in plaintext like the rest of
  // this table; there's no column-level encryption anywhere in this schema,
  // so this is the same trust boundary as, say, resumeUrl. Backup codes are
  // bcrypt-hashed and single-use (removed from the array once consumed).
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]  @default([])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  talent                 TalentProfile?
  employer               EmployerProfile?
  jobAlerts              JobAlert[]
  savedJobs              SavedJob[]
  notificationPreference NotificationPreference?
  jobReports             JobReport[]
  notifications          Notification[]
  messages               Message[]
  reviewsWritten         Review[]                @relation("ReviewsWritten")
  reviewsReceived        Review[]                @relation("ReviewsReceived")
  profileViewsMade       ProfileView[]           @relation("ProfileViewsMade")

  @@map("users")
}

// Settings > Notifications toggles. One row per user, created on first read
// (see NotificationsRepository.upsertRow) rather than at signup — nothing
// currently sends notifications gated by these, so they're a persisted
// preference with no reader yet, same caveat as the Account fields above.
model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  applicationUpdates Boolean  @default(true)
  employerMessages   Boolean  @default(true)
  weeklyDigest       Boolean  @default(true)
  instantMatchAlerts Boolean  @default(true)
  productNews        Boolean  @default(false)
  tipsAndResources   Boolean  @default(true)
  browserPush        Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

enum NotificationType {
  INVITATION_RECEIVED
  APPLICATION_STATUS_CHANGED
  JOB_REPORT_RESOLVED
  MESSAGE_RECEIVED
  INTERVIEW_PROPOSED
  INTERVIEW_CONFIRMED
}

// In-app notification feed (bell + /notifications page). Content is baked in
// at creation time — same philosophy as EmailService.sendXxx hard-coding
// subject/HTML at send time rather than computing it at read time — so
// `type` is a lean classifier only (future per-type icon), never used to
// derive title/body/link dynamically. Not gated by NotificationPreference:
// that model governs the external email/push channel, this is a separate,
// always-on in-app channel.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?          @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// Settings > Security "Active sessions". Repurposed from an unused NextAuth-
// pattern leftover (sessionToken/expires, never read or written anywhere) —
// now the real backing store for revocable sessions: every access token
// carries this row's id as its `sid` claim (see JwtPayload), and
// JwtStrategy.validate rejects any token whose session is missing or
// revokedAt is set. userAgent/ip are the raw request values, parsed into a
// friendly "Chrome on macOS"-style label only at read time (see
// common/utils/user-agent.util.ts) so improving that parser needs no backfill.
model Session {
  id         String    @id @default(cuid())
  userId     String
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Talent ───────────────────────────────────────────────────────────────────

model TalentProfile {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  slug               String                   @unique
  headline           String?
  bio                String?                  @db.Text
  location           String?
  country            String?
  timezone           String?
  yearsExperience    Int?
  level              ExperienceLevel          @default(MID)
  resumeUrl          String?
  portfolioUrl       String?
  githubUrl          String?
  linkedinUrl        String?
  isOpenToWork       Boolean                  @default(true)
  // Settings > Privacy & data "Profile visibility". Distinct from
  // isOpenToWork (whether you're currently looking) — this is who can see
  // the profile at all. Defaults to PUBLIC (today's de facto behavior, so
  // adding this column changes nothing for existing profiles); switching to
  // VERIFIED_EMPLOYERS is enforced in TalentService.getPublicProfile, which
  // 404s the (unauthenticated, or non-employer, or unverified-employer)
  // caller exactly as if the slug didn't exist.
  visibility         TalentVisibility         @default(PUBLIC)
  desiredSalaryMin   Int?
  desiredSalaryMax   Int?
  currency           String                   @default("USD")
  // Profile setup "About you" / "Job preferences" — decorative in the reference
  // design, but real, persisted fields here. Stored as plain strings/arrays
  // (not Prisma enums) validated against a closed set in talentProfileSchema,
  // matching the User.language/region/currencyDisplay convention.
  primaryRole        String?
  rightToWork        String?
  employmentTypes    String[]                 @default([])
  timezoneOverlap    String[]                 @default([])
  noticePeriod       String?
  // Self-service email verification — same shape as EmployerProfile's
  // isVerified/verificationEmail/verificationStatus, minus a domain-match
  // requirement (a person has no company website to match against, so
  // submitting is just proving control of the address). isVerified is the
  // one flag any badge reads; verificationEmail/verificationStatus track
  // the submission process and stay internal (never in publicProfileArgs).
  isVerified         Boolean                  @default(false)
  verifiedAt         DateTime?
  verificationEmail  String?
  verificationStatus TalentVerificationStatus @default(NOT_SUBMITTED)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills             TalentSkill[]
  applications       Application[]
  invitations        JobInvitation[]
  workExperiences    WorkExperience[]
  profileHighlights  ProfileHighlight[]
  emailVerifications TalentEmailVerification[]
  profileViews       ProfileView[]

  @@map("talent_profiles")
}

enum TalentVerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  FAILED
}

// Mirrors EmployerEmailVerification's own-table reasoning exactly (see that
// model's comment) — kept separate from VerificationToken (auth's
// password-reset table) to avoid the same cross-purpose-collision risk.
model TalentEmailVerification {
  id         String    @id @default(cuid())
  talentId   String
  email      String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  talent TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@index([talentId, createdAt])
  @@map("talent_email_verifications")
}

enum ProfileHighlightType {
  PORTFOLIO
  EDUCATION
  LANGUAGE
}

// Profile setup "Selected work" / "Education" / "Languages" — one model for
// all three since they're all "a short list of labeled entries" shaped the
// same way, just with different fields populated per `type` (validated in
// the module's Zod schemas, not enforced by the DB). Capped at
// MAX_HIGHLIGHTS_PER_TYPE entries per type per profile.
model ProfileHighlight {
  id          String               @id @default(cuid())
  talentId    String
  type        ProfileHighlightType
  // PORTFOLIO: project title / EDUCATION: school name / LANGUAGE: language name
  title       String
  // PORTFOLIO: role · duration / EDUCATION: degree · field / LANGUAGE: proficiency level
  subtitle    String?
  // PORTFOLIO: description — unused for EDUCATION/LANGUAGE
  description String?              @db.Text
  // PORTFOLIO: category tag (e.g. "Product · Production") — unused otherwise
  tag         String?
  // PORTFOLIO: project link — unused otherwise
  url         String?
  // EDUCATION only — unused otherwise
  startYear   Int?
  // EDUCATION only; null = ongoing — unused otherwise
  endYear     Int?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  talent TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@index([talentId, type])
  @@map("profile_highlights")
}

// Profile setup "Experience" — up to MAX_WORK_EXPERIENCES_PER_PROFILE entries
// per profile (enforced in WorkExperienceService.create), same "list up to N
// roles" cap the reference design's copy implies.
model WorkExperience {
  id          String    @id @default(cuid())
  talentId    String
  company     String
  title       String
  location    String?
  // null endDate = current role ("Present" in the UI).
  startDate   DateTime
  endDate     DateTime?
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  talent TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@index([talentId])
  @@map("work_experiences")
}

model Skill {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  talentSkills TalentSkill[]
  jobSkills    JobSkill[]

  @@map("skills")
}

model TalentSkill {
  talentId String
  skillId  String
  yearsExp Int?

  talent TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  skill  Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([talentId, skillId])
  @@map("talent_skills")
}

// ─── Employer ─────────────────────────────────────────────────────────────────

model EmployerProfile {
  id                 String                     @id @default(cuid())
  userId             String                     @unique
  companyName        String
  slug               String                     @unique
  logoUrl            String?
  websiteUrl         String?
  description        String?                    @db.Text
  industry           String?
  size               String?
  founded            Int?
  hqCountry          String?
  hqCity             String?
  isVerified         Boolean                    @default(false)
  // Neither is derivable from updatedAt: a later profile edit (updateProfile)
  // moves updatedAt without touching verification status, and re-verifying
  // after a suspension would otherwise erase the original suspension time.
  verifiedAt         DateTime?
  suspendedAt        DateTime?
  // Self-service domain/email verification — a second, independent path to
  // isVerified alongside the existing admin verify/suspend toggle (that
  // field stays the one gate every badge/check reads; this just tracks the
  // submission process that can also flip it true). verificationEmail is
  // the last address submitted, kept even after success/failure for
  // display ("verified via jane@acme.com").
  verificationEmail  String?
  verificationStatus EmployerVerificationStatus @default(NOT_SUBMITTED)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs               Job[]
  invitations        JobInvitation[]
  emailVerifications EmployerEmailVerification[]

  // Composite, not single-column: AdminRepository.findEmployers filters
  // isVerified and orders by createdAt desc — the plain isVerified index
  // only covered the filter half, forcing a separate sort.
  @@index([isVerified, createdAt])
  @@map("employer_profiles")
}

enum EmployerVerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  FAILED
}

// Deliberately its own table, not a reuse of VerificationToken — that
// table's createVerificationToken unconditionally deletes every prior
// token for an `identifier` (see auth.repository.ts), so sharing it across
// a password-reset flow and this one for the same email address could
// silently invalidate an unrelated in-flight reset. Same reasoning as
// JobInvitation getting its own model instead of overloading Application.
model EmployerEmailVerification {
  id         String    @id @default(cuid())
  employerId String
  email      String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  employer EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId, createdAt])
  @@map("employer_email_verifications")
}

// ─── Jobs ─────────────────────────────────────────────────────────────────────

model Job {
  id               String          @id @default(cuid())
  employerId       String
  title            String
  slug             String          @unique
  description      String          @db.Text
  requirements     String?         @db.Text
  responsibilities String?         @db.Text
  jobType          JobType         @default(FULL_TIME)
  level            ExperienceLevel @default(MID)
  salaryMin        Int?
  salaryMax        Int?
  currency         String          @default("USD")
  isRemote         Boolean         @default(true)
  timezone         String?
  country          String?
  applicationUrl   String?
  status           JobStatus       @default(DRAFT)
  planType         PlanType        @default(STANDARD)
  planPaid         Boolean         @default(false)
  paidAt           DateTime?
  benefits         String[]        @default([])
  vnHireCount      Int             @default(0)
  stripeSessionId  String?
  reviewNote       String?         @db.Text
  isFeatured       Boolean         @default(false)
  viewCount        Int             @default(0)
  applyCount       Int             @default(0)
  publishedAt      DateTime?
  expiresAt        DateTime?
  // Approval already has a natural audit timestamp in publishedAt (set the
  // moment JobsRepository.approveJob runs) — rejection had nothing: status
  // flipped to REJECTED with no record of when, so an owner's later edit
  // (which moves updatedAt) erases the only trace of the original rejection
  // time.
  rejectedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Restrict, not Cascade: this used to cascade all the way from a User
  // delete (User -> EmployerProfile -> Job -> Application/SavedJob), so an
  // employer self-deleting their account silently destroyed every talent's
  // application history and saved-job bookmarks for that employer's
  // postings — data those other users never chose to delete. Restrict makes
  // that impossible at the database level: UsersService.deleteAccount now
  // checks for and blocks on existing jobs before attempting the delete,
  // and this constraint is the backstop if that check is ever bypassed.
  employer     EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Restrict)
  skills       JobSkill[]
  applications Application[]
  invitations  JobInvitation[]
  categories   JobCategory[]
  savedBy      SavedJob[]
  reports      JobReport[]

  @@index([status, publishedAt])
  @@index([status, isFeatured, publishedAt])
  // Composite, not single-column: EmployerRepository.findJobsByEmployer
  // filters employerId (+ optional status) and orders by createdAt desc —
  // the plain employerId index only covered the filter half, forcing a
  // separate sort on every employer's job-list page.
  @@index([employerId, createdAt])
  // AdminRepository.findJobs filters status and orders by createdAt asc —
  // distinct from the publishedAt-ordered indexes above (the moderation
  // queue sorts oldest-pending-first, not by publish date).
  @@index([status, createdAt])
  @@index([planPaid, paidAt])
  // Covers GET /jobs?country=... and the timezone-bucket filters (job-search.util.ts's
  // tzCondition) — country equality combined with the status filter every search
  // already applies, previously unindexed together.
  @@index([status, country])
  // Covers GET /jobs?sort=salary (buildJobOrderBy), which orders by salaryMax
  // with no index to back it — previously a full sort over every ACTIVE row.
  @@index([status, salaryMax])
  @@map("jobs")
}

model Category {
  id   String  @id @default(cuid())
  name String  @unique
  slug String  @unique
  icon String?

  jobs            JobCategory[]
  alertCategories AlertCategory[]

  @@map("categories")
}

model JobCategory {
  jobId      String
  categoryId String

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([jobId, categoryId])
  // The composite PK is ordered (jobId, categoryId), so it doesn't serve a
  // lookup by categoryId alone efficiently — SalaryRepository walks
  // Category -> jobs (filtering job_categories by categoryId) to compute
  // salary benchmarks, which needed exactly this index.
  @@index([categoryId])
  @@map("job_categories")
}

model JobSkill {
  jobId      String
  skillId    String
  isRequired Boolean @default(true)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

// ─── Applications ─────────────────────────────────────────────────────────────

model Application {
  id                 String            @id @default(cuid())
  jobId              String
  talentId           String
  coverLetter        String?           @db.Text
  resumeUrl          String?
  status             ApplicationStatus @default(PENDING)
  notes              String?           @db.Text
  appliedAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  // Application Transparency — set once, the first time this row appears in
  // an employer's GET /employer/jobs/:id/applications response (see
  // EmployerRepository.findApplicationsForJob). Distinct from `status`
  // changing: an employer can see a candidate in the list without having
  // acted on them yet.
  viewedAt           DateTime?
  // Backlog-reminder cron dedupe (ApplicationsService's cron/reminders) —
  // null until the first reminder fires, then re-stamped each time so the
  // same stuck application isn't re-emailed every run.
  lastReminderSentAt DateTime?

  job          Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  talent       TalentProfile            @relation(fields: [talentId], references: [id], onDelete: Cascade)
  statusEvents ApplicationStatusEvent[]
  messages     Message[]
  interview    Interview?
  reviews      Review[]

  @@unique([jobId, talentId])
  @@index([talentId, appliedAt])
  @@index([jobId, appliedAt])
  // Backs the backlog-reminder cron's WHERE status IN (...) AND appliedAt < ...
  @@index([status, appliedAt])
  @@map("applications")
}

// A single 1:1 thread per Application — the natural, already-authorized
// boundary between one talent and one employer. No per-message readAt:
// unread signaling is fully delegated to the Notification Center (a new
// message creates a MESSAGE_RECEIVED Notification) instead of a second,
// parallel unread system.
model Message {
  id            String   @id @default(cuid())
  applicationId String
  senderId      String
  body          String   @db.Text
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  // Without this, DELETE /users/me's cascade (UsersService.deleteAccount)
  // has to full-scan `messages` to find this user's sent rows — messages
  // is the highest-write-volume table in the schema (up to 30 inserts/hour
  // per user, no cap on thread count), so this index matters more here than
  // it would on a low-volume table.
  @@index([senderId])
  @@map("messages")
}

enum InterviewStatus {
  PENDING
  CONFIRMED
}

// 1:1 with Application (applicationId unique) — v1 supports exactly one
// active interview per application, no history of past proposals and no
// CANCELLED state (confirmed with the user: v1 has no cancel/decline path —
// the employer may revise proposedSlots freely while still PENDING, but the
// row is locked once CONFIRMED).
model Interview {
  id              String          @id @default(cuid())
  applicationId   String          @unique
  durationMinutes Int
  proposedSlots   DateTime[]
  confirmedSlot   DateTime?
  meetingUrl      String?
  status          InterviewStatus @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("interviews")
}

// One row per status an Application has ever been in (including the initial
// PENDING at creation) — the talent-facing timeline (Application
// Transparency) and the employer's avgFirstResponseHours SLA metric are both
// computed by reading this log rather than inferring history from `status`
// alone, which only ever holds the current value.
model ApplicationStatusEvent {
  id            String            @id @default(cuid())
  applicationId String
  status        ApplicationStatus
  createdAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("application_status_events")
}

// ─── Invitations ────────────────────────────────────────────────────────────
// An employer inviting a candidate (from Talent Search) to apply to a
// specific job. Deliberately its own model rather than a new Application
// status — accepting one creates a real Application via the same path a
// self-initiated apply uses, so the existing status pipeline (pending ->
// reviewing -> ... -> offered), ApplicantsPanel, and match scoring never
// need to know an invitation was involved. Cascade on all three relations
// (unlike Application/Job.employer's Restrict) — an invitation has no
// independent record-keeping value once its job/talent/employer is gone.
model JobInvitation {
  id          String           @id @default(cuid())
  jobId       String
  talentId    String
  employerId  String
  message     String?          @db.Text
  status      InvitationStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  job      Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  talent   TalentProfile   @relation(fields: [talentId], references: [id], onDelete: Cascade)
  employer EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@unique([jobId, talentId])
  @@index([talentId, status, createdAt])
  @@map("job_invitations")
}

// A talent or employer flagging a listing as suspicious/scam. Deliberately
// its own table, not a flag/count on Job — a report is a signal *about* a
// job, not a moderation action taken *on* it, so Job.status is never touched
// by this flow (same reasoning JobInvitation got its own model instead of
// overloading Application). No DB-level uniqueness on (jobId, reporterId): a
// true "one OPEN report per pair" constraint needs a partial unique index,
// which isn't worth the hand-edited-migration complexity for this low-stakes
// write — JobReportsService enforces it with a plain read-check instead.
model JobReport {
  id         String          @id @default(cuid())
  jobId      String
  reporterId String
  reason     JobReportReason
  details    String?         @db.Text
  status     JobReportStatus @default(OPEN)
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())

  job      Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([jobId])
  @@map("job_reports")
}

// ─── Job Alerts ───────────────────────────────────────────────────────────────

model JobAlert {
  id         String           @id @default(cuid())
  userId     String
  name       String
  keywords   String?
  jobType    JobType?
  level      ExperienceLevel?
  salaryMin  Int?
  country    String?
  timezone   String?
  frequency  AlertFrequency   @default(DAILY)
  isActive   Boolean          @default(true)
  lastSentAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories AlertCategory[]

  // Composite, not single-column: findByUser (alerts.repository.ts) filters
  // userId and orders by createdAt desc; findActiveAlerts filters isActive
  // and orders by lastSentAt (nulls first) — each composite index lets
  // Postgres satisfy its query's filter+sort from the index alone.
  @@index([userId, createdAt])
  @@index([isActive, lastSentAt])
  @@map("job_alerts")
}

model SavedJob {
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  // Composite so findAllForUser's userId filter + createdAt desc sort
  // (saved.repository.ts) is satisfied by the index alone, not a separate sort.
  @@index([userId, createdAt])
  @@map("saved_jobs")
}

model AlertCategory {
  alertId    String
  categoryId String

  alert    JobAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([alertId, categoryId])
  @@map("alert_categories")
}

enum AdminAuditAction {
  EMPLOYER_VERIFIED
  EMPLOYER_SUSPENDED
  JOB_APPROVED
  JOB_REJECTED
  JOB_REPORT_RESOLVED
  JOB_REPORT_DISMISSED
}

enum AdminAuditTargetType {
  EMPLOYER
  JOB
  JOB_REPORT
}

// Durable record of every admin moderation action (who / what / when /
// target / before / after) — closes the gap where these decisions were
// previously only Logger.log'd (see AdminService/JobReportsService's prior
// comments), with nothing to show during a dispute beyond app logs.
// Deliberately NOT a Prisma relation to User: an audit record has to survive
// the actor's account being renamed or deleted, so adminEmail is a snapshot
// taken at write time, not a live join — same reasoning as targetLabel.
model AdminAuditLog {
  id          String               @id @default(cuid())
  adminId     String
  adminEmail  String
  action      AdminAuditAction
  targetType  AdminAuditTargetType
  targetId    String
  targetLabel String
  before      Json?
  after       Json?
  createdAt   DateTime             @default(now())

  // Backs "history for this job/employer/report" (targetType+targetId) and
  // "everything admin X has done" (adminId) — both real read patterns for a
  // moderation audit trail, plus the plain reverse-chronological feed.
  @@index([targetType, targetId, createdAt])
  @@index([adminId, createdAt])
  @@index([createdAt])
  @@map("admin_audit_log")
}

enum ReviewDirection {
  TALENT_TO_EMPLOYER
  EMPLOYER_TO_TALENT
}

// No HIDDEN-by-moderation flow exists yet — status starts as the only lever
// available (PUBLISHED always, today), kept as a real column rather than
// hardcoding "always visible" in every query, so a moderation/mutual-reveal
// feature can add a second value later without a schema change or a backfill.
enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

// Eligibility rule (see ReviewsService.isEligibleInteraction): a review is
// only creatable once the Application's Interview has been CONFIRMED *and*
// its confirmedSlot has passed — "the interview is complete," not just
// booked. This is the strongest verified two-sided interaction this schema
// has today (both parties agreed on an actual time, and it's already
// happened), stronger than an application's own `status` field, which an
// employer can set to INTERVIEW/OFFERED without any real Interview ever
// having been proposed or confirmed. There's no "hired"/employment model to
// build a stronger rule on top of.
model Review {
  id                     String          @id @default(cuid())
  applicationId          String
  direction              ReviewDirection
  reviewerId             String
  revieweeId             String
  overallRating          Int
  // Nullable, not four required columns: which of these apply depends on
  // `direction` (see ReviewsService's direction-specific validation) — a
  // TALENT_TO_EMPLOYER review never has reliabilityRating, an
  // EMPLOYER_TO_TALENT review never has interviewProcessRating.
  communicationRating    Int?
  professionalismRating  Int?
  interviewProcessRating Int?
  reliabilityRating      Int?
  comment                String?         @db.Text
  status                 ReviewStatus    @default(PUBLISHED)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    User        @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee    User        @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  // One review per reviewer per verified interaction — deliberately NOT
  // unique(reviewerId, revieweeId): the same talent and employer can
  // legitimately interact again through a different application later.
  @@unique([reviewerId, applicationId])
  // Backs GET /reviews/user/:userId's aggregate + list query (filter by
  // revieweeId + status, sorted newest first).
  @@index([revieweeId, status, createdAt])
  @@map("reviews")
}

// Only a real Employer viewing a Talent profile is ever recorded (never a
// Talent viewing anyone, and never an anonymous request) — see
// ProfileViewsService.recordView, the only writer of this table; there is no
// public/manual API to create one directly. Deduplicated to one row per
// (viewer, talent, calendar day) via the unique constraint below, so
// refreshing a profile repeatedly in one sitting doesn't inflate totalViews
// — the upsert on that key either inserts the first view of the day or
// no-ops on a repeat.
model ProfileView {
  id        String   @id @default(cuid())
  viewerId  String
  talentId  String
  viewDate  DateTime @db.Date
  createdAt DateTime @default(now())

  viewer User          @relation("ProfileViewsMade", fields: [viewerId], references: [id], onDelete: Cascade)
  talent TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@unique([viewerId, talentId, viewDate])
  // Backs getAnalytics's count() + groupBy(viewerId) for one talent.
  @@index([talentId, createdAt])
  @@map("profile_views")
}
