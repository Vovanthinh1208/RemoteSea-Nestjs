# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://remotesea:remotesea_password@localhost:5432/remotesea_dev
# Prisma pool sizing (optional). Unset = Prisma's default of CPUs × 2 + 1
# connections, which varies per machine — set an explicit limit when running
# against a hosted Postgres with a connection budget (e.g. Supabase: each
# session-mode pooler client holds a real DB connection; size this so
# instances × limit stays inside your plan's budget). DATABASE_POOL_TIMEOUT is
# how long (seconds) a query waits for a free connection before failing.
#DATABASE_CONNECTION_LIMIT=10
#DATABASE_POOL_TIMEOUT=20
# Seconds before Postgres cancels a running statement (optional). Unset = no
# timeout — a lock-contended or runaway query then holds its pool connection
# indefinitely, queuing every other request behind it under load.
#DATABASE_STATEMENT_TIMEOUT=10

# ─── Auth (JWT replaces NextAuth session) ─────────────────────────────────────
AUTH_SECRET=your-32-char-secret-change-in-production
# Optional, stable 32+ character key for encrypting TOTP secrets at rest.
# If unset, AUTH_SECRET is used as key material.
# TWO_FACTOR_ENCRYPTION_KEY=
JWT_EXPIRES_IN=7d

# OAuth Providers (optional — feature degrades gracefully when unset)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback
# "Sign In with LinkedIn using OpenID Connect" product on a LinkedIn Developer app
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=
AUTH_LINKEDIN_CALLBACK_URL=http://localhost:4000/auth/linkedin/callback

# ─── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=RemoteSEA <noreply@remotesea.io>

# ─── File Storage (S3-compatible) ─────────────────────────────────────────────
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
CDN_URL=

# ─── Stripe (job posting payments) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Cron ──────────────────────────────────────────────────────────────────────
CRON_SECRET=

# ─── Observability ──────────────────────────────────────────────────────────────
# Unset = no error tracking, not a boot failure. Create a project at sentry.io
# (or a self-hosted instance) to get a DSN.
SENTRY_DSN=
# Bearer secret for GET /metrics (same pattern as CRON_SECRET) — unset means
# the route always 401s. Point your Prometheus scrape config's bearer_token at
# this same value.
METRICS_SECRET=

# ─── AI (CV analysis) ──────────────────────────────────────────────────────────
# Unset = the ai-cv-analysis endpoint returns 503 rather than the app failing to boot.
# ANTHROPIC or GEMINI — only the matching *_API_KEY below needs to be set.
AI_PROVIDER=ANTHROPIC
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── AI Orchestrator (remotesea-ai, separate service) ──────────────────────────
# AI_SERVICE_SECRET must match the same value in remotesea-ai's own .env.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=

ADDITIONAL_CORS_ORIGINS=https://remotesea-web.fly.dev
